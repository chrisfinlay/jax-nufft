{
  "schema": "v0.2.0-vs-ducc0",
  "provenance": {
    "measured": "2026-09-07/08",
    "machine": "CSCS Alps/Daint, one GH200 node (72-core NVIDIA Grace CPU, 288 hardware threads; H100 GPU, 96 GB HBM)",
    "jax_nufft_device": "gpu",
    "ducc0_device": "cpu (same node)",
    "epsilon": 1e-06,
    "dtype": "float64",
    "channel_strategy": "scan",
    "w_strategy": "auto",
    "protocol": "Plan built and one warm-up call made outside the timed window; median of >= 7 calls, each ending in block_until_ready(). Each ducc0 thread count was measured in its own process: an in-process sweep let NUMA placement from a previous high-thread-count run contaminate later cells by about 2x.",
    "ducc0_role": "Black-box oracle through its public Python API only. ducc0 is GPL-2.0-or-later; no ducc0 source was consulted for this project."
  },
  "sizing": {
    "rationale": "The built-in test fixtures in tests/conftest.py are CI-sized (400-600 rows, 64-256 pixels) and are not representative: they under-resolve the field of view and hold far fewer visibilities than any real observation. The 'realistic' suite overrides both dimensions from instrument parameters, so the comparison is made at sizes a user would actually run.",
    "pixsize_rule": "pixsize = lambda / (3 * max_baseline_m)  -- three pixels across the synthesised beam",
    "n_pix_rule": "n_pix = next even 5-smooth integer >= fov_rad / pixsize",
    "n_rows_rule": "n_rows = 150 * n_ant * (n_ant - 1) / 2  -- 150 time samples on every baseline",
    "telescopes": {
      "EDA2": {
        "freq_hz": 200000000.0,
        "max_baseline_m": 35.0,
        "fov_deg": 120.0,
        "n_ant": 256
      },
      "MWA_compact": {
        "freq_hz": 150000000.0,
        "max_baseline_m": 200.0,
        "fov_deg": 25.0,
        "n_ant": 128
      },
      "MWA_extended": {
        "freq_hz": 150000000.0,
        "max_baseline_m": 5300.0,
        "fov_deg": 25.0,
        "n_ant": 128
      },
      "MeerKAT": {
        "freq_hz": 1280000000.0,
        "max_baseline_m": 8000.0,
        "fov_deg": 1.5,
        "n_ant": 64
      }
    }
  },
  "suites": {
    "realistic": "Sized by the rules above from instrument parameters.",
    "ci_sized": "The unmodified tests/conftest.py fixtures (plus GH200_large), kept so the effect of the sizing can be seen rather than asserted."
  },
